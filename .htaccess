# Caminho: .htaccess
# 99BKP-DOMAIN-BLOCK
# Domínio: app.digital.log.br
# URL: https://app.digital.log.br
# Gerado automaticamente pelo 99BKP em 2026-10-26 20:32:34
# END-99BKP-DOMAIN-BLOCK

<IfModule mod_headers.c>
 Header always set Content-Security-Policy "frame-ancestors https://99bkp.arcoll.com.br"
</IfModule>

Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.(?!well-known)|\.json$|\.log$|\.lock$|\.tmp$|\.sql$|\.md$|^error_log$|legacy-dashboard\.html$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
 RewriteRule ^manifest\.webmanifest$ api/manifest.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>

<FilesMatch "^(config\.php|bootstrap\.php)$">
 Require all denied
</FilesMatch>
