<IfModule mod_headers.c>
 Header always set Content-Security-Policy "frame-ancestors https://99bkp.arcoll.com.br"
</IfModule>

Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.(?!well-known)|\.json$|\.log$|\.lock$|\.tmp$|\.sql$|\.md$|^error_log$|legacy-dashboard\.html$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
 RewriteRule ^manifest\.webmanifest$ api/manifest.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>

<FilesMatch "^(config\.php|bootstrap\.php)$">
 Require all denied
</FilesMatch>
