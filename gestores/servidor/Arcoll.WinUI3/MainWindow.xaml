<!-- Caminho: gestores/servidor/Arcoll.WinUI3/MainWindow.xaml -->
<!-- Shell híbrido T.I. Digital: menu superior compacto, submenu contextual e conteúdo em largura total. -->
<Window x:Class="Arcoll.WinUI3.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="T.I Digital — Gestor Windows">
 <Grid x:Name="RootGrid" Loaded="CompactShell_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <!-- Modelo simples: as cores são calculadas em código (PaintNavigation), sem estados visuais internos que apaguem a seleção. -->
   <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="Button">
       <ContentPresenter Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}"/>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="RibbonTab" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="CornerRadius" Value="8,8,0,0"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontSize" Value="11"/>
   </Style>
   <Style x:Key="QuickButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="MinWidth" Value="30"/>
    <Setter Property="MinHeight" Value="30"/>
   </Style>
   <Style TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,7"/><Setter Property="CornerRadius" Value="10"/></Style>
   <Style TargetType="ComboBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="38"/><Setter Property="CornerRadius" Value="10"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
  </Grid.RowDefinitions>

  <Border x:Name="QuickBar" Background="#FFFFFF" BorderThickness="0">
   <Grid Padding="6,3,6,0" ColumnSpacing="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <!-- Legacy metadata remains named for existing branding code; the visible identity lives in the footer. -->
    <StackPanel Visibility="Collapsed"><TextBlock x:Name="BrandSubtitle" Text="T.I. DIGITAL · GESTOR WINDOWS"/></StackPanel>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
     <StackPanel x:Name="CategoryTabs" Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom" AutomationProperties.Name="Categorias do gestor"/>
    </ScrollViewer>
    <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource QuickButton}" Click="GestorUpdate_Open_Click" ToolTipService.ToolTip="Central de atualização do gestor" AutomationProperties.Name="Central de atualização do gestor" AutomationProperties.AutomationId="quick-refresh"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
    <Button x:Name="RemoteButton" Grid.Column="3" Style="{StaticResource QuickButton}" Click="RemoteAccess_Click" ToolTipService.ToolTip="Código de acesso remoto" AutomationProperties.Name="Gerar código de acesso remoto" AutomationProperties.AutomationId="remote-access"><FontIcon Glyph="&#xE890;" FontSize="17"/></Button>
   </Grid>
  </Border>

  <Border x:Name="CategoryBar" Grid.Row="1" Visibility="Collapsed" Height="0" Background="Transparent"/>
  <Border x:Name="RibbonBar" Grid.Row="1" BorderThickness="0,0,0,1" CornerRadius="0" Padding="4,1,4,1" Background="#F6F8FC">
   <ScrollViewer x:Name="RibbonScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
    <StackPanel x:Name="RibbonMenus" Orientation="Horizontal" Padding="0" Spacing="1" AutomationProperties.Name="Menus da categoria"/>
   </ScrollViewer>
  </Border>

  <Grid Grid.Row="2" x:Name="WorkspaceRoot">
   <Grid RowSpacing="0" Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="HeroFrame" Grid.Row="1" Visibility="Collapsed" Height="0" MinHeight="0" Padding="0" Margin="0" BorderThickness="0" Background="Transparent">
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" Background="#D9E9FF" CornerRadius="13" VerticalAlignment="Center"><FontIcon x:Name="HeroIcon" Glyph="&#xE80F;" FontSize="24" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
       <TextBlock x:Name="HeroTitle" Text="Painel" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="HeroDescription" Text="Visão geral das informações do ambiente" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Border Grid.Column="2" Visibility="Collapsed" Padding="12,7" CornerRadius="12" Background="#DDEBFC" VerticalAlignment="Center"><TextBlock x:Name="HeroTag" Text="PAINEL DE CONTROLE" FontSize="10" FontWeight="SemiBold"/></Border>
     </Grid>
    </Border>
    <Grid Grid.Row="2" x:Name="PageRegion">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     </ScrollViewer>
     <ContentControl x:Name="CompactHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
     <WebView2 x:Name="HybridDashboard" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     <Border x:Name="PageLoadingOverlay" Grid.Row="0" Background="#DCE9F5" Opacity="0.95" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="99">
      <Button x:Name="PageLoadingButton" Click="PageLoadingButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="24" AutomationProperties.Name="Carregar ou atualizar dados da página">
       <StackPanel HorizontalAlignment="Center" Spacing="7">
        <ProgressRing x:Name="PageLoadingRing" Width="64" Height="64" IsActive="False" HorizontalAlignment="Center"/>
        <TextBlock x:Name="PageLoadingPercent" Text="0%" FontSize="22" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageLoadingStage" Text="Carregar dados" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="270"/>
        <TextBlock Text="Clique para carregar novamente" Opacity="0.65" FontSize="11" HorizontalAlignment="Center"/>
       </StackPanel>
      </Button>
     </Border>
     <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
    </Grid>
   </Grid>
  </Grid>

  <Border x:Name="StatusBorder" Grid.Row="3" BorderThickness="0,1,0,0" Background="#FFFFFF">
   <Grid Padding="8,2" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="FooterNetworkIdentity" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.42">
     <Button x:Name="BrandButton" Style="{StaticResource FlatButton}" Tag="panel" Click="Menu_Click" Padding="0" MinWidth="0" MinHeight="24" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Painel da rede" AutomationProperties.Name="Painel da rede" AutomationProperties.AutomationId="quick-panel">
      <Grid ColumnSpacing="7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="NetworkBadge" Width="24" Height="24" CornerRadius="4" Padding="2" BorderThickness="0">
        <TextBlock Text="REDE" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock x:Name="NetworkTitle" Grid.Column="1" Text="Rede" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="network-title"/>
      </Grid>
     </Button>
    </Border>
    <!-- Retained only for the existing tray/status logic; no Connected label is rendered. -->
    <TextBlock x:Name="ConnectionLabel" Visibility="Collapsed" IsHitTestVisible="False"/>
    <TextBlock x:Name="FooterText" Grid.Column="1" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Grid x:Name="GateOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#E6101826">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Padding="20">
    <TextBlock x:Name="GateText" Foreground="White" FontSize="17" TextWrapping="Wrap" TextAlignment="Center"/>
    <Button Content="Verificar novamente" HorizontalAlignment="Center" Click="GateRetry_Click"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
