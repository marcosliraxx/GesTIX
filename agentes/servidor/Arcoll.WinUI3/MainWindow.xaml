<!-- Caminho: agentes/servidor/Arcoll.WinUI3/MainWindow.xaml -->
<Window x:Class="Arcoll.WinUI3.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="T.I Digital — Agente Windows">
 <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="MenuButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="3,4"/><Setter Property="MinWidth" Value="0"/></Style>
   <Style TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/></Style>
   <Style TargetType="ComboBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="30"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="22"/><RowDefinition Height="78"/></Grid.RowDefinitions>
  <Border x:Name="TopBar" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <Grid x:Name="TopMenus"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border x:Name="TopSeparator1" BorderThickness="0,0,1,0"><Button x:Name="CleanMenu" Style="{StaticResource MenuButton}" Tag="clean" Click="Menu_Click" AutomationProperties.Name="Clean" AutomationProperties.AutomationId="nav-clean"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Delete"/><TextBlock Text="Clean" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></Border>
     <Border x:Name="TopSeparator2" Grid.Column="1" BorderThickness="0,0,1,0"><Button x:Name="ProgramsMenu" Style="{StaticResource MenuButton}" Tag="programs" Click="Menu_Click" AutomationProperties.Name="Programas" AutomationProperties.AutomationId="nav-programs"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Library"/><TextBlock Text="Programas" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></Border>
     <Border x:Name="TopSeparator3" Grid.Column="2" BorderThickness="0,0,1,0"><Button x:Name="DevicesMenu" Style="{StaticResource MenuButton}" Tag="devices" Click="Menu_Click" AutomationProperties.Name="Dispositivos" AutomationProperties.AutomationId="nav-devices"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="AllApps"/><TextBlock Text="Dispositivos" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></Border>
     <Border x:Name="TopSeparator4" Grid.Column="3" BorderThickness="0,0,1,0"><Button x:Name="MapMenu" Style="{StaticResource MenuButton}" Tag="map" Click="Menu_Click" AutomationProperties.Name="Mapa" AutomationProperties.AutomationId="nav-map"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Map"/><TextBlock Text="Mapa" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></Border>
     <Border x:Name="TopSeparator5" Grid.Column="4" BorderThickness="0,0,1,0"><Button x:Name="FilesMenu" Style="{StaticResource MenuButton}" Tag="files" Click="Menu_Click" AutomationProperties.Name="Arquivos" AutomationProperties.AutomationId="nav-files"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Folder"/><TextBlock Text="Arquivos" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></Border>
    </Grid>
    <Button x:Name="RemoteButton" Grid.Column="1" Style="{StaticResource MenuButton}" Click="RemoteAccess_Click" ToolTipService.ToolTip="Código de acesso remoto" AutomationProperties.Name="Gerar código de acesso remoto" AutomationProperties.AutomationId="remote-access"><FontIcon Glyph="&#xE83B;" FontSize="22" HorizontalAlignment="Center"/></Button>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="8" Padding="12,10"><ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"/><InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/></StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ConnectionLabel" Text="Conectando" FontSize="11" VerticalAlignment="Center"/>
   <TextBlock x:Name="FooterText" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>
  <Border x:Name="BottomBar" Grid.Row="3" BorderThickness="0,1,0,0">
   <Grid x:Name="BottomMenus"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="BottomSeparator1" BorderThickness="0,0,1,0"><Button x:Name="ServerMenu" Style="{StaticResource MenuButton}" Tag="server" Click="Menu_Click" AutomationProperties.Name="Servidor" AutomationProperties.AutomationId="nav-server"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Home"/><TextBlock Text="Servidor" FontSize="12"/></StackPanel></Button></Border>
    <Border x:Name="BottomSeparator2" Grid.Column="1" BorderThickness="0,0,1,0"><Button x:Name="InternetMenu" Style="{StaticResource MenuButton}" Tag="speed" Click="Menu_Click" AutomationProperties.Name="Internet" AutomationProperties.AutomationId="nav-internet"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="World"/><TextBlock Text="Internet" FontSize="12"/></StackPanel></Button></Border>
    <Border x:Name="BottomSeparator3" Grid.Column="2" BorderThickness="0,0,1,0"><Button x:Name="PanelMenu" Style="{StaticResource MenuButton}" Tag="panel" Click="Menu_Click" AutomationProperties.Name="Painel" AutomationProperties.AutomationId="nav-panel"><StackPanel Spacing="2" HorizontalAlignment="Center"><Border x:Name="NetworkBadge" Width="46" Height="46" CornerRadius="23" Padding="5" BorderThickness="2" AutomationProperties.Name="Logo da rede"><TextBlock Text="REDE" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Painel" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></Border>
    <Border x:Name="BottomSeparator4" Grid.Column="3" BorderThickness="0,0,1,0"><Button x:Name="SupportMenu" Style="{StaticResource MenuButton}" Tag="support" Click="Menu_Click" AutomationProperties.Name="Suporte" AutomationProperties.AutomationId="nav-support"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Help"/><TextBlock Text="Suporte" FontSize="12"/></StackPanel></Button></Border>
    <Button x:Name="TicketsMenu" Grid.Column="4" Style="{StaticResource MenuButton}" Tag="tickets" Click="Menu_Click" AutomationProperties.Name="Chamados" AutomationProperties.AutomationId="nav-tickets"><StackPanel Spacing="3" HorizontalAlignment="Center"><SymbolIcon Symbol="Message"/><TextBlock Text="Chamados" FontSize="12"/></StackPanel></Button>
   </Grid>
  </Border>
  <Grid x:Name="GateOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#E6101826"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Padding="20"><TextBlock x:Name="GateText" Foreground="White" FontSize="17" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="Verificar novamente" HorizontalAlignment="Center" Click="GateRetry_Click"/></StackPanel></Grid>
 </Grid>
</Window>
