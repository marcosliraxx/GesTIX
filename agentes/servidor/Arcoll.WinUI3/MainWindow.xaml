<!-- Caminho: agentes/servidor/Arcoll.WinUI3/MainWindow.xaml -->
<Window x:Class="Arcoll.WinUI3.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="T.I Digital — Agente Windows">
 <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="RibbonTab" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="3,3,0,0"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/></Style>
   <Style x:Key="QuickButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="30"/></Style>
   <Style TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/></Style>
   <Style TargetType="ComboBox"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="30"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Border x:Name="QuickBar" BorderThickness="0,0,0,1">
   <Grid Padding="6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="BrandButton" Style="{StaticResource QuickButton}" Tag="panel" Click="Menu_Click" ToolTipService.ToolTip="Painel da rede" AutomationProperties.Name="Painel da rede" AutomationProperties.AutomationId="quick-panel"><Border x:Name="NetworkBadge" Width="24" Height="24" CornerRadius="12" Padding="2" BorderThickness="1"><TextBlock Text="REDE" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Button>
    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource QuickButton}" Click="Refresh_Click" ToolTipService.ToolTip="Verificar conexão e configurações" AutomationProperties.Name="Verificar conexão e configurações" AutomationProperties.AutomationId="quick-refresh"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
    <Button x:Name="RemoteButton" Grid.Column="3" Style="{StaticResource QuickButton}" Click="RemoteAccess_Click" ToolTipService.ToolTip="Código de acesso remoto" AutomationProperties.Name="Gerar código de acesso remoto" AutomationProperties.AutomationId="remote-access"><FontIcon Glyph="&#xE83B;" FontSize="16"/></Button>
   </Grid>
  </Border>
  <Border x:Name="CategoryBar" Grid.Row="1">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
    <StackPanel x:Name="CategoryTabs" Orientation="Horizontal" Padding="6,0" AutomationProperties.Name="Categorias do agente"/>
   </ScrollViewer>
  </Border>
  <Border x:Name="RibbonBar" Grid.Row="2" BorderThickness="0,0,0,1">
   <ScrollViewer x:Name="RibbonScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
    <StackPanel x:Name="RibbonMenus" Orientation="Horizontal" Padding="6,3" AutomationProperties.Name="Menus da categoria"/>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="3" Padding="10,8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch"/></ScrollViewer>
   <ContentControl x:Name="CompactHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
   <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
  </Grid>
  <Border x:Name="StatusBorder" Grid.Row="4" BorderThickness="0,1,0,0"><Grid Padding="10,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ConnectionLabel" Text="Conectando" FontSize="11" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="FooterText" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid></Border>
  <Grid x:Name="GateOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#E6101826"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Padding="20"><TextBlock x:Name="GateText" Foreground="White" FontSize="17" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="Verificar novamente" HorizontalAlignment="Center" Click="GateRetry_Click"/></StackPanel></Grid>
 </Grid>
</Window>
